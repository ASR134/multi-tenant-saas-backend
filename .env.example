SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

REDIS_URL=redis://localhost:6379

# database configuration
DATABASE_URL=postgresql+asyncpg://postgres:your-password-here@localhost:5432/saas_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here
POSTGRES_DB=saas_db

# email verification
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30

# rate limit configuration
LOGIN_EMAIL_IP_LIMIT=5
LOGIN_IP_LIMIT=10
LOGIN_WINDOW=600

# email service configuration
RESEND_API_KEY=your-api-key-here
EMAIL_FROM=your-sending-email
FRONTEND_URL=http://localhost:5173

# password forget/reset
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# invitation expiry
INVITATION_TOKEN_EXPIRE_DAYS=7

# test database
TEST_DATABASE_URL=postgresql+asyncpg://postgres:your-password-here@localhost:5432/saas_test_db